# Public URL of the site, used for canonical links, sitemap and social previews
NEXT_PUBLIC_SITE_URL=https://vimmik.vercel.app

# Contact form delivery (https://resend.com). Without a key the form opens the
# visitor's email app pre-filled instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@vimmik.com
# Must be a sender on a domain verified in Resend, e.g. "VIMMIK Website <web@vimmik.com>"
CONTACT_FROM_EMAIL=
